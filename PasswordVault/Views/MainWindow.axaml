<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PasswordVault.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="800"
        Width="650" Height="500"
        CanMaximize="False"
        MinWidth="550" MinHeight="400"
        x:Class="PasswordVault.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        xmlns:m="using:PasswordVault.Models"
        Icon="/Assets/avalonia-logo.ico"
        Title="PassVault">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

        <TabControl Margin="5">
            <TabItem Header="Генератор паролей" FontSize="14">
                <Grid Margin="20"
                      RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="15"
                      ColumnDefinitions="*, *, *" ColumnSpacing="15">
                    <TextBox
                        Text="{Binding PasswordEntry}"
                        PlaceholderText="Введите свой пароль..."
                        Grid.Row="0"
                        Grid.ColumnSpan="3"/>
                    <ProgressBar
                        Minimum="0"
                        Maximum="120"
                        Height="5"
                        Value="{Binding PasswordEntryStrength}"
                        Grid.Row="1"
                        Grid.ColumnSpan="3">
                    </ProgressBar>
                    <CheckBox
                        IsChecked="{Binding UseUpper}"
                        Content="Использовать заглавные буквы"
                        Grid.Row="2"
                        Grid.Column="0"/>
                    <CheckBox
                        IsChecked="{Binding UseDigits}"
                        Content="Использовать цифры"
                        Grid.Row="2"
                        Grid.Column="1"/>
                    <CheckBox
                        IsChecked="{Binding UseSymbols}"
                        Content="Использовать специальные символы"
                        Grid.Row="2"
                        Grid.Column="2"/>
                    <Slider 
                        Maximum="32"
                        Minimum="8" 
                        Value="{Binding Length}"
                        Grid.Row="3"
                        Grid.ColumnSpan="3"/>
                    <TextBlock 
                        Text="{Binding Length, StringFormat='Количество символов: {0}'}"
                        Grid.Row="4"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Center"/>
                    <Button
                        Content="Сгенерировать"
                        Command="{Binding GenerateNewPasswordCommand}"
                        Grid.Row="5"
                        Grid.Column="0"/>
                    <Button
                        Content="Скопировать"
                        Command="{Binding CopyGeneratedPasswordCommand}"
                        Grid.Row="5"
                        Grid.Column="2"/>
                </Grid>
            </TabItem>
            <TabItem Header="Менеджер паролей" FontSize="14">
                <Grid>
                    <Grid IsVisible="{Binding IsPasswordRequired}"
                        Margin="20"
                        RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="15"
                        ColumnDefinitions="*, Auto" ColumnSpacing="15">
                        <TextBox Text="{Binding SelectedVaultPath}"
                                 IsReadOnly="True"
                                 Grid.Row="0" Grid.Column="0"/>
                        <Button Content="Обзор..."
                                Command="{Binding SelectVaultFileCommand}"
                                Grid.Row="0" Grid.Column="1"/>
                        <TextBox
                             Text="{Binding MasterPassword}"
                             PlaceholderText="Введите пароль от хранилища..."
                             PasswordChar="●"
                             TextWrapping="NoWrap"
                             AcceptsReturn="False"
                             AcceptsTab="False"
                             VerticalAlignment="Center"
                             Grid.Row="1">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding UnlockVaultCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button
                            Content="Войти"
                            Command="{Binding UnlockVaultCommand}"
                            VerticalAlignment="Center"
                            Grid.Row="2"/>
                        <TextBlock
                            Text="{Binding ErrorMessage}"
                            Foreground="Red"
                            Grid.Row="3"/>
                    </Grid>
                    <Grid IsVisible="{Binding !IsPasswordRequired}"
                        Margin="20"
                        RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, *" RowSpacing="15"
                        ColumnDefinitions="*, Auto" ColumnSpacing="15">
                        <TextBox
                            Text="{Binding Title}"
                            PlaceholderText="Введите название..."
                            Grid.Row="0"
                            Grid.ColumnSpan="2"/>
                        <TextBox
                            Text="{Binding Login}"
                            PlaceholderText="Введите свой логин..."
                            Grid.Row="1"
                            Grid.ColumnSpan="2"/>
                        <TextBox
                            Text="{Binding Password}"
                            PlaceholderText="Введите свой пароль..."
                            Grid.Row="2"
                            Grid.Column="0"/>
                        <Button
                            Content="Сгенерировать"
                            Command="{Binding FastGenerateCommand}"
                            VerticalAlignment="Center"
                            Grid.Row="2"
                            Grid.Column="1"/>
                        <TextBox
                            Text="{Binding Category}"
                            PlaceholderText="Введите категорию..."
                            Grid.Row="3"
                            Grid.ColumnSpan="2"/>
                        <Button
                            Content="Сохранить"
                            Command="{Binding SaveEntryCommand}"
                            VerticalAlignment="Center"
                            Grid.Row="4"
                            Grid.ColumnSpan="2"/>
                        <TextBox
                            PlaceholderText="Фильтр..."
                            Text="{Binding SearchText}"
                            Grid.Row="5"
                            Grid.ColumnSpan="2">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Escape" Command="{Binding ClearSearchCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <ListBox
                            ItemsSource="{Binding Entries}"
                            Grid.Row="6"
                            Grid.ColumnSpan="2">
                            <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="m:PasswordEntry">
                        <Border Background="#15808080" 
                                CornerRadius="8" 
                                Padding="10" 
                                BorderBrush="Gray" 
                                BorderThickness="1">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Копировать запись"
                                              Command="{Binding $parent[Window].DataContext.CopyEntryPasswordCommand}"
                                              CommandParameter="{Binding}"/>
                                    <MenuItem Header="Удалить запись"
                                              Command="{Binding $parent[Window].DataContext.DeleteEntryCommand}"
                                              CommandParameter="{Binding}"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding Login}" FontWeight="Bold" FontSize="18"/>
                                    <TextBlock Text="{Binding Password}" FontSize="12"/>
                                    <TextBlock Text="{Binding Category}" FontSize="8" Opacity="0.6"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="✕"
                                        Command="{Binding $parent[Window].DataContext.DeleteEntryCommand}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

</Window>

