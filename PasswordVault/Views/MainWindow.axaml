<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PasswordVault.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="800"
        Width="500" Height="370"
        CanResize="False"
        CanMaximize="False"
        CanMinimize="True"
        x:Class="PasswordVault.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="PassVault">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

        <TabControl Margin="5" HorizontalAlignment="Center">
            <TabItem Header="Генератор паролей" FontSize="14">
                <Grid Margin="20"
                      RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" RowSpacing="15"
                      ColumnDefinitions="*, *, *" ColumnSpacing="15">
                    <TextBox
                        Text="{Binding PasswordEntry}"
                        PlaceholderText="Введите свой пароль..."
                        Grid.Row="0"
                        Grid.ColumnSpan="3"/>
                    <ProgressBar
                        Minimum="0"
                        Maximum="120"
                        Height="5"
                        Value="{Binding PasswordEntryStrength}"
                        Grid.Row="1"
                        Grid.ColumnSpan="3">
                    </ProgressBar>
                    <CheckBox
                        IsChecked="{Binding UseUpper}"
                        Content="Использовать заглавные буквы"
                        Grid.Row="2"
                        Grid.Column="0"/>
                    <CheckBox
                        IsChecked="{Binding UseDigits}"
                        Content="Использовать цифры"
                        Grid.Row="2"
                        Grid.Column="1"/>
                    <CheckBox
                        IsChecked="{Binding UseSymbols}"
                        Content="Использовать специальные символы"
                        Grid.Row="2"
                        Grid.Column="2"/>
                    <Slider 
                        Maximum="32"
                        Minimum="8" 
                        Value="{Binding Length}"
                        Grid.Row="3"
                        Grid.ColumnSpan="3"/>
                    <TextBlock 
                        Text="{Binding Length, StringFormat='Количество символов: {0}'}"
                        Grid.Row="4"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Center"/>
                    <Button
                        Content="Сгенерировать"
                        Command="{Binding GenerateNewPasswordCommand}"
                        Grid.Row="5"
                        Grid.Column="0"/>
                    <Button
                        Content="Скопировать"
                        Command="{Binding CopyGeneratedPasswordCommand}"
                        Grid.Row="5"
                        Grid.Column="2"/>
                </Grid>
            </TabItem>
            <TabItem Header="Менеджер паролей" FontSize="14">
                <Grid Margin="20"
                      RowDefinitions="Auto" RowSpacing="15"
                      ColumnDefinitions="*" ColumnSpacing="15">
                    <Popup 
                        Grid.Row="0"
                        Grid.Column="0">
                        <Grid Margin="20"
                              RowDefinitions="Auto, Auto" RowSpacing="15"
                              ColumnDefinitions="*" ColumnSpacing="15">
                        <TextBox
                            Text="{Binding _masterPassword}"
                             PasswordChar="●"
                             TextWrapping="NoWrap"
                             AcceptsReturn="False"
                             AcceptsTab="False"
                             VerticalAlignment="Center"
                             Grid.Row="0"
                             Grid.Column="0"/>
                        <Button
                            Content="Войти"
                            VerticalAlignment="Center"
                            Grid.Row="1"
                            Grid.Column="0"/>
                        </Grid>
                    </Popup>
                </Grid>
            </TabItem>
        </TabControl>

</Window>

