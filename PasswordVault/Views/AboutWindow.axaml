<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PasswordVault.Views.AboutWindow"
        Title="О программе"
        Width="360" Height="220"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/PassVault-logo.ico">

    <StackPanel Margin="20" Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="PassVault" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="Версия 1.0.0" Opacity="0.7" HorizontalAlignment="Center"/>
        <TextBlock Text="Локальный менеджер паролей с шифрованием AES-256-GCM."
                   TextWrapping="Wrap"
                   TextAlignment="Center"/>
        <Button Content="Закрыть"
                Click="CloseButton_Click"
                HorizontalAlignment="Center"
                Margin="0,10,0,0"/>
    </StackPanel>
</Window>